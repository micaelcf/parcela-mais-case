# Dev-safe values only. Copy to .env.local for `vp run up` (dev) and to .env for
# `vp run up --prod` / `vp run deploy` (compose reads .env). Never use these keys in production.
# No value may contain a dollar sign: Bun and Compose expand it even inside quotes.

# Postgres. Use localhost, never 127.0.0.1 (Podman publishes on the IPv6 loopback only).
# Inside compose the app, worker and migrate services override this with STACK_DATABASE_URL.
DATABASE_URL=postgres://parcela:parcela@localhost:5432/parcela

# Credentials of the compose `postgres` service (compose reads them from .env). In dev they default
# to these values (compose.dev.yaml), so DATABASE_URL above must match them. compose.yaml has no
# default password: set a strong, URL-safe one in .env before `vp run deploy`, or the stack fails
# closed. Postgres reads them only when it initialises its volume; to change the password of an
# existing volume, ALTER USER inside it first.
POSTGRES_USER=parcela
POSTGRES_PASSWORD=parcela
POSTGRES_DB=parcela
# Database URL the app, worker and migrate containers use. Empty: the compose `postgres` service with
# the credentials above. Set it to point the stack at a managed Postgres.
STACK_DATABASE_URL=

# PII protection: base64 of exactly 32 bytes each.
PII_HMAC_KEY=OGMbFz1WZiOGiNxoeUig8SA4lWacvzJz1eMhYkW7RjQ=
PII_ENCRYPTION_KEY=gu4xQy/vHhZ/DwdwzSbEz6En+EgUsJ2hA0Fx1p/n5Xk=
PII_KEY_VERSION=1

# Backoffice operator. Dev password: parcela-dev. Make your own hash with
# `vp run backoffice:hash-password` (format scrypt:N:r:p:salt:hash).
BACKOFFICE_USERNAME=operador
BACKOFFICE_PASSWORD_HASH=scrypt:16384:8:1:6IIOg6aU6ghno/Im4v1VOw==:o8gNZadUn8pZR5An4tJ6TRPDvQjjsQaiTpWqd3hYFKIwKNoki7bz1eOBD0tmEMWNpNRsJmnaIHau941hljR78w==
BACKOFFICE_SESSION_SECRET=dev-only-session-secret-c4urj5HSWJxly23dROdMASq0j

# Simulation and lenders.
SIMULATION_CONTROLS=true
LENDER_BASE_URL=http://localhost:3000/api/simulator/lenders
CONSULTATION_DEADLINE_MS=10000
SIMULATOR_TIME_SCALE=1
SIMULATOR_DELTA_FAILURE_RATE=0.3

# Abuse limits (RFC O2, provisional).
RATE_LIMIT_PATIENT_MAX=5
RATE_LIMIT_PATIENT_WINDOW_HOURS=24
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_IP_WINDOW_MINUTES=60

# Reported by /api/health; `vp run deploy` sets it to `git rev-parse HEAD`.
GIT_SHA=dev
NODE_ENV=development

# Caddy site address (prod profile). Empty: plain HTTP on :80 inside the container.
APP_DOMAIN=

# Host ports published by compose. POSTGRES_PORT is published only by `vp run up` (compose.dev.yaml).
POSTGRES_PORT=5432
HTTP_PORT=8080
HTTPS_PORT=8443

# Ops scripts: podman | docker. Empty: Podman when installed, else Docker.
CONTAINER_ENGINE=
